SERVER_HOST=127.0.0.1
SERVER_PORT=3000
DB_PATH=data/biblioteca.db
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional reverse proxy on the same machine (Caddy/nginx). Leave blank otherwise.
TRUST_PROXY=
# Optional absolute backup directory outside public (default: data/backups).
BACKUP_DIR=
